# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=paper_bottle
PORT=3000

# LLM
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_CALL_TIMEOUT_SECONDS=60
AGENT_MAX_ATTEMPTS=2
AGENT_TIME_BUDGET_SECONDS=120

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=72

# LangGraph workflow checkpoints
ICE_BREAK_CHECKPOINT_PATH=data/ice_break_checkpoints.sqlite3
PICK_WORKFLOW_CHECKPOINT_PATH=data/pick_workflow_checkpoints.sqlite3

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=piaoliuping

# Optional MCP servers
MCP_TRENDS_HUB_ENABLED=false
MCP_SEARCH1API_ENABLED=false
MCP_SEARCH1API_KEY=
